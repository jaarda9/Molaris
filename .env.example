# Gemini API key for M.O.L.A.R.I.S senior clinical dental reasoning and vision diagnosis
GEMINI_API_KEY=your_gemini_api_key_here
PORT=3000

# Shared password required to access the app (there is no per-user login).
# Generate one with: openssl rand -base64 18
APP_PASSWORD=change_me

# Secret used to sign session cookies. Generate one with: openssl rand -hex 32
SESSION_SECRET=change_me_too
