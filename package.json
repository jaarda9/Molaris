{
  "name": "molaris-dental-assistant",
  "version": "1.0.0",
  "description": "M.O.L.A.R.I.S: Personal Senior Dental Advisor & Chairside Clinical Assistant",
  "main": "server.ts",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --target=node20 --outfile=dist/server.cjs --external:express --external:@google/genai --external:ws --external:multer --external:express-session --external:express-rate-limit --external:better-sqlite3",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "db:demo": "tsx scripts/reset-demo.ts"
  },
  "dependencies": {
    "@google/genai": "^2.0.0",
    "better-sqlite3": "11.10.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "multer": "^1.4.5-lts.1",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3"
  }
}
